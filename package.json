{
  "name": "mpi-field-tools-native",
  "version": "0.1.0",
  "private": true,
  "description": "Native iOS shell for the Michigan Property Inspections field workflow.",
  "type": "module",
  "scripts": {
    "native:prepare": "node scripts/prepare-native-web.mjs",
    "native:add:ios": "pnpm run native:prepare && cap add ios",
    "native:sync": "pnpm run native:prepare && cap sync ios",
    "native:doctor": "node scripts/native-doctor.mjs",
    "native:verify": "pnpm run native:sync && node scripts/verify-native.mjs",
    "native:simulator": "node scripts/simulator-smoke.mjs",
    "native:device:compile": "xcodebuild -quiet -project ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphoneos -destination 'generic/platform=iOS' -derivedDataPath /tmp/mpi-field-tools-device-deriveddata CODE_SIGNING_ALLOWED=NO build",
    "native:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/camera": "8.2.4",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor-firebase/authentication": "8.5.1",
    "@capacitor-firebase/messaging": "8.5.1",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@mpi/background-location": "file:native-plugins/mpi-background-location",
    "firebase": "12.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.19.0"
}
